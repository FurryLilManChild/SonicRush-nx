+    uint8_t hdr[54] = {'B', 'M'};
+    auto put32 = [&](int o, uint32_t v) { for (int i = 0; i < 4; ++i) hdr[o + i] = (v >> (8 * i)) & 0xFF; };
+    put32(2, 54 + img); put32(10, 54); put32(14, 40); put32(18, w);
+    put32(22, static_cast<uint32_t>(-h));   // top-down rows
+    hdr[26] = 1; hdr[28] = 32; put32(34, img);
+    std::fwrite(hdr, 1, 54, f);
+    std::vector<uint32_t> row(w);
+    for (int y = 0; y < 384; ++y) {
+        const uint32_t* src = y < 192 ? top + y * top_w + (top_w - 256) / 2
+                                      : bottom + (y - 192) * bottom_w + (bottom_w - 256) / 2;
+        for (int x = 0; x < 256; ++x)
+            for (int k = 0; k < kS; ++k) row[x * kS + k] = src[x] | 0xFF000000u;
+        for (int k = 0; k < kS; ++k) std::fwrite(row.data(), 4, w, f);
+    }
+    std::fclose(f);
+    std::snprintf(g_nx_capture_msg, sizeof g_nx_capture_msg, "Saved capture %03u", n);
