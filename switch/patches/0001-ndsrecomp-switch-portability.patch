+static void nx_write_capture(const uint32_t* top, int top_w, const uint32_t* bottom, int bottom_w) {
+    static const int kS = 3;
+    const int w = 256 * kS, h = 384 * kS;
+    mkdir(MPHNX_APP_DIR "/captures", 0777);
+    char path[96];
+    unsigned n = 1;
+    for (; n < 10000; ++n) {
+        std::snprintf(path, sizeof path, MPHNX_APP_DIR "/captures/cap-%03u.bmp", n);
+        FILE* t = std::fopen(path, "rb");
+        if (!t) break;
+        std::fclose(t);
