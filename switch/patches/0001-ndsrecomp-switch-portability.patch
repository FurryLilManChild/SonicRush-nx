+#pragma once
+// SonicRush-nx: 3D projection remap for the stage view (see GPU3D.cpp).
+struct SrnxRemap {
+    int on = 0;
+    long long ax = 65536, bx = 0, ay = 65536, by = 0;   // 16.16
+    int rx0 = 0, ry0 = 0, rw = 256, rh = 192;           // DS-screen pixels covered
+    int wx = 0, wy = 0;   // level position of the DS screen's top-left when the geometry was built
+};
+extern SrnxRemap g_srnx_remap_next, g_srnx_remap_cur, g_srnx_remap_render;
+// Fill the coefficients for a rectangle of the DS screen's pixel space.
+inline void srnx_remap_set(SrnxRemap& r, int rx0, int ry0, int rw, int rh) {
+    r.rx0 = rx0; r.ry0 = ry0; r.rw = rw; r.rh = rh;
+    r.ax = (256LL << 16) / rw;
+    r.bx = ((long long)(256 - 2 * rx0 - rw) << 16) / rw;
+    r.ay = (192LL << 16) / rh;
+    r.by = ((long long)(rh - 192 + 2 * ry0) << 16) / rh;
+    r.on = 1;
+}
