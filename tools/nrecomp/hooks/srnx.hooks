# Sonic Rush (USA, ASCE v0) port hooks. Format: see load_hooks in gen.py.
# Central sprite routine, clip test (reached only when the sprite asks for clipping).
# r5 = x, r4 = y (20.12, camera-relative); [sp+0x44], [sp+0x46] = width, height; [r10] = OAM manager.
@020329F4
{ int _c = srnx_spr_clip(r5, r4, NR_RD16(r13 + 0x44u), NR_RD16(r13 + 0x46u), NR_LDR32(r10));
  if (_c > 0) goto L_02032A5C; if (_c == 0) goto L_02032A24; }
# Right after the slot allocator: r0 = OAM slot, r5 = x, r4 = y.
@02032B40
r4 = srnx_spr_record(r0, r5, r4, NR_LDR32(r10));
# Animated sprite routine 0x02032D2C, whole-sprite clip (flag 0x4000): screen x = [sp+0x10],
# y = [sp+0x14]; box x [x+r12, x+r9], y [y+r11, y+r8]; r5 = OAM manager. Off screen returns
# through the 'le' exit at 0x02032E78 (fz = 1 makes it taken).
@02032E6C
{ int32_t _x = (int32_t)NR_LDR32(r13 + 0x10u), _y = (int32_t)NR_LDR32(r13 + 0x14u);
  int _c = srnx_spr_box(_x + (int32_t)r12, _x + (int32_t)r9, _y + (int32_t)r11, _y + (int32_t)r8, r5);
  if (_c > 0) goto L_02032ECC; if (_c == 0) { fz = 1; goto L_02032E78; } }
# Second sprite routine (the one most stage objects use): r8 = x, r9 = y in pixels,
# [r2], [r2+2] = width, height, [r10] = OAM manager.
@02033058
{ int _c = srnx_spr_clip(r8 << 12, r9 << 12, NR_RD16(r2), NR_RD16(r2 + 2u), NR_LDR32(r10));
  if (_c > 0) goto L_020330C4; if (_c == 0) goto L_0203308C; }
@020330D0
r9 = (uint32_t)((int32_t)srnx_spr_record(r0, r8 << 12, r9 << 12, NR_LDR32(r10)) >> 12);
# Who is drawing: the animated sprite routine called from 0x02032C8C (lr 0x02032D14)
# draws the HUD (score, time, rings, lives); everything else is the stage.
@02032D2C
srnx_spr_enter(1, r14);
@02032480
srnx_spr_enter(0, r14);
# caller of the multi-part routine 0x02032C8C (it calls 0x02032D2C per part)
@02032C8C
srnx_spr_enter(2, r14);
# Object activation (overlay 0, 0x02334EB4): the area around the camera in
# which the game brings objects to life is [sp+0x20] x0, [sp+0x24] y0,
# [sp+0x28] x1 and y1 = r1 + (r2 >> 8) (computed next); with the stage view
# on, widen it to cover our view (r0 holds x0 for the clamp that follows).
@ov00:02334FB0
if (g_srnx_wide) { r0 -= (uint32_t)g_srnx_act_l; NR_WR32(r13 + 0x20u, r0);
  NR_WR32(r13 + 0x24u, NR_RD32(r13 + 0x24u) - (uint32_t)g_srnx_act_t);
  NR_WR32(r13 + 0x28u, NR_RD32(r13 + 0x28u) + (uint32_t)g_srnx_act_r); r1 += (uint32_t)g_srnx_act_b; }
# Its per-screen twin (overlay 0, 0x023350C0: one camera record, 192 rows),
# same rect layout; widened the same way.
@ov00:023351B8
if (g_srnx_wide) { r0 -= (uint32_t)g_srnx_act_l; NR_WR32(r13 + 0x20u, r0);
  NR_WR32(r13 + 0x24u, NR_RD32(r13 + 0x24u) - (uint32_t)g_srnx_act_t);
  NR_WR32(r13 + 0x28u, NR_RD32(r13 + 0x28u) + (uint32_t)g_srnx_act_r); r1 += (uint32_t)g_srnx_act_b; }
# Object keep-alive range check (main 0x02068E58): an object outside the DS
# view plus margin r2 (default 64 px) is flagged for deletion (obj+0x54 bit 4)
# every frame, so objects spawned by the widened scanners died before drawing.
# Widen the margin to cover the stage view.
@02068EB4
if (g_srnx_wide) r2 += (uint32_t)g_srnx_keep_margin;
# switch-test15: the camera records just swapped (main and other DS screen);
# 3D geometry from here on is built for the other screen
@ov00:0233B600
srnx_wide_cam_swapped();
